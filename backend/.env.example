# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/autoworkshop

# Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30d

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=admin@mvssautomobiles.com

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Meta WhatsApp Cloud API Configuration
META_WA_ACCESS_TOKEN=your_meta_wa_access_token_here
META_WA_PHONE_NUMBER_ID=your_meta_wa_phone_number_id_here
META_WA_APP_SECRET=your_meta_wa_app_secret_here
META_WA_VERIFY_TOKEN=your_meta_wa_webhook_verify_token_here

# WhatsApp Automation Feature Flags (Client Configuration)
# The following 3 automations are DISABLED by default per client request.
# Set to 'true' to re-enable them if requested by the client in the future.
WA_ENABLE_INSPECTION_COMPLETED=false
WA_ENABLE_INVOICE_GENERATED=false
WA_ENABLE_WORK_STARTED=false
